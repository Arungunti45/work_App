rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      // For this phase, assuming isAdmin relies on a custom claim or checking a user profile.
      // Easiest is checking the user profile document role:
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Existing Profile Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
                   && request.auth.uid == userId
                   && request.resource.data.uid == userId
                   && request.resource.data.accountStatus == 'active';
      allow update: if isAuthenticated() 
                   && request.auth.uid == userId
                   && request.resource.data.uid == userId
                   && request.resource.data.accountStatus == resource.data.accountStatus
                   && request.resource.data.role != 'ADMIN';
      allow delete: if false; 
    }

    match /users/{userId}/savedJobs/{jobId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /interviews/{interviewId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.workerId || request.auth.uid == resource.data.employerId);
      allow write: if false; // Only via Cloud Functions
    }

    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if false; // Only via Cloud Functions
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds; 
      allow delete: if false;

      match /participants/{userId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow write: if isAuthenticated() && request.auth.uid == userId; // Allow user to update their own read state/mute
      }

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        // Allow sending messages if participant. Ensure senderId matches auth.uid
        allow create: if isAuthenticated() 
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.type != 'SYSTEM';
        allow update: if isAuthenticated() 
                      && request.resource.data.senderId == request.auth.uid
                      && resource.data.senderId == request.auth.uid; // Only edit own message
        allow delete: if false; // Soft delete via update
      }
    }

    match /workerProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() 
                            && request.auth.uid == userId
                            && (!request.resource.data.keys().hasAll(['verificationStatus']) 
                                || request.resource.data.verificationStatus == resource.data.verificationStatus 
                                || request.resource.data.verificationStatus == 'unverified');
      allow delete: if false;
    }

    match /employerProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() 
                            && request.auth.uid == userId
                            && (!request.resource.data.keys().hasAll(['verificationStatus']) 
                                || request.resource.data.verificationStatus == resource.data.verificationStatus 
                                || request.resource.data.verificationStatus == 'unverified');
      allow delete: if false;
    }

    match /contractorProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() 
                            && request.auth.uid == userId
                            && (!request.resource.data.keys().hasAll(['verificationStatus']) 
                                || request.resource.data.verificationStatus == resource.data.verificationStatus 
                                || request.resource.data.verificationStatus == 'unverified');
      allow delete: if false;
    }

    // Phase 4: Categories and Skills
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Phase 4: Jobs
    match /jobs/{jobId} {
      // Anyone can read APPROVED & PUBLISHED jobs.
      // Owners can read their own jobs. Admins can read all.
      allow read: if (resource.data.moderationStatus == 'APPROVED' && resource.data.status == 'PUBLISHED')
                  || (isAuthenticated() && resource.data.employerId == request.auth.uid)
                  || isAdmin();
                  
      // Employers can CREATE drafts. Server sets moderationStatus/status if submitting.
      allow create: if isAuthenticated() 
                    && request.resource.data.employerId == request.auth.uid
                    && request.resource.data.status == 'DRAFT'
                    && request.resource.data.moderationStatus == 'NOT_SUBMITTED';

      // Employers can UPDATE drafts or update basic info on published jobs (which requires function).
      // Client-side, we only allow updates to their own DRAFT or REJECTED jobs.
      // Other state changes MUST go through Cloud Functions.
      allow update: if isAuthenticated() 
                    && resource.data.employerId == request.auth.uid
                    && request.resource.data.employerId == request.auth.uid
                    // Cannot change server-controlled fields
                    && request.resource.data.moderationStatus == resource.data.moderationStatus
                    && request.resource.data.moderatedBy == resource.data.moderatedBy
                    && request.resource.data.moderatedAt == resource.data.moderatedAt
                    && request.resource.data.status == resource.data.status;
                    
      // Jobs are never deleted, only archived.
      allow delete: if false;
    }

    // Phase 4: Audit Logs
    match /audit_logs/{logId} {
      // Only admins can read all logs. 
      // Write is strictly blocked for clients. Cloud Functions bypass this rule.
      allow read: if isAdmin();
      allow write: if false;
    }

    // ================================================================
    // Phase 9: Notifications
    // ================================================================
    match /users/{userId}/notifications/{notificationId} {
      // Users can read and manage only their own notifications
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Only trusted server code can CREATE notifications
      allow create: if false;
      // Users can mark their own notifications read or delete them
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    // Only allow updating read state fields — not type/title/body/userId
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.type == resource.data.type
                    && request.resource.data.title == resource.data.title;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Phase 9: Notification Preferences
    match /users/{userId}/notificationPreferences/{docId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Phase 9: FCM Tokens — strictly per-user
    match /users/{userId}/notificationTokens/{tokenId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ================================================================
    // Phase 10: Verifications
    // ================================================================
    match /verifications/{verificationId} {
      // Owner can read their own verification record
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;
      // Users can create their own verification — backend validates duplicate PENDING
      // We allow client create here so submitVerification CF can use a transaction.
      // The CF is the authoritative path; this allows reading status back.
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'PENDING'
                    // Cannot set review fields from client
                    && request.resource.data.reviewedBy == null
                    && request.resource.data.reviewedAt == null;
      // Only trusted server code updates verification status
      allow update, delete: if false;
    }

    // ================================================================
    // Phase 10: Reports
    // ================================================================
    match /reports/{reportId} {
      // Reporter can read their own submitted reports
      allow read: if isAuthenticated()
                  && resource.data.reporterId == request.auth.uid;
      // Users can create reports about others (not themselves)
      allow create: if isAuthenticated()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.targetId != request.auth.uid
                    // Cannot set resolution fields
                    && request.resource.data.status == 'OPEN'
                    && request.resource.data.resolvedBy == null;
      // Status changes, resolution — server only
      allow update, delete: if false;
    }

    // ================================================================
    // Phase 10: Block lists — strictly private per-user
    // ================================================================
    match /users/{userId}/blockedUsers/{blockedUserId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
