rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidDocument() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }

    function isUnderSizeLimit(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024;
    }

    // ────────────────────────────────────────────────────────────────
    // Phase 8: Chat attachments
    // ────────────────────────────────────────────────────────────────
    match /conversations/{conversationId}/attachments/{attachmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && isUnderSizeLimit(5);
      allow update, delete: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // Phase 10: Verification documents
    // PRIVATE: only the document owner may read/write their own files.
    // Admin access must be done via signed URLs generated by Cloud Functions.
    // ────────────────────────────────────────────────────────────────
    match /users/{uid}/verification/{verificationId}/{documentId} {
      // Owner reads their own verification documents only
      allow read: if isOwner(uid);
      // Owner uploads their own documents: images or PDFs under 5MB
      allow create: if isOwner(uid)
                    && isValidDocument()
                    && isUnderSizeLimit(5);
      // Once submitted, documents cannot be replaced or deleted from client
      allow update, delete: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // Phase 10: Report evidence
    // Reporter can upload evidence when filing a report.
    // Only admin can read — access is via signed URLs from Cloud Functions.
    // ────────────────────────────────────────────────────────────────
    match /reports/{reportId}/evidence/{evidenceId} {
      // No direct public read — admin accesses via signed URLs from CF
      allow read: if false;
      // Authenticated users can upload evidence (images/PDFs under 5MB)
      allow create: if isAuthenticated()
                    && isValidDocument()
                    && isUnderSizeLimit(5);
      allow update, delete: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // Profile photos, portfolio images (from Phase 3)
    // ────────────────────────────────────────────────────────────────
    match /profiles/{uid}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid)
                   && isValidImage()
                   && isUnderSizeLimit(10);
    }

    // ────────────────────────────────────────────────────────────────
    // Phase 12: Support Attachments
    // ────────────────────────────────────────────────────────────────
    match /supportTickets/{ticketId}/attachments/{attachmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && isValidDocument()
                    && isUnderSizeLimit(5);
      allow update, delete: if false;
    }

    // ────────────────────────────────────────────────────────────────
    // Phase 13: Invoices
    // Invoices are private and only generated by Cloud Functions
    // ────────────────────────────────────────────────────────────────
    match /invoices/{userId}/{invoiceId} {
      allow read: if isOwner(userId);
      allow write: if false; // Only Cloud Functions create invoices
    }

    // ────────────────────────────────────────────────────────────────
    // Default: deny all other paths
    // ────────────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
