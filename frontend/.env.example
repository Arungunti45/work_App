# GET YOUR JOB - Frontend Environment Configuration

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Other Configuration
VITE_API_URL=https://your-api-url.com

# Payment Provider Configuration (Public keys only)
VITE_PAYMENT_PUBLIC_KEY=pk_test_12345

# IMPORTANT: The following secrets MUST ONLY be added to the Firebase Functions Environment or Secret Manager.
# Do NOT place these inside the frontend .env file in production!
# PAYMENT_SECRET_KEY=sk_test_12345
# PAYMENT_WEBHOOK_SECRET=whsec_12345
